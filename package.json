{
    "name": "simulacro-nodejs",
    "version": "1.0.0",
    "description": "API REST Modular Layered Architecture",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "seed": "tsx src/core/database/run.seeders.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "nodejs",
        "express",
        "typescript",
        "sequelize",
        "modular"
    ],
    "author": "Alejandro Escobar",
    "license": "ISC",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "joi": "^17.13.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.3.0",
        "pg": "^8.11.5",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.19.43",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }

# ENVIRONMENT CONFIGURATION

# 1. APPLICATION (Node.js / Express)

# Runtime environment (development, production, test)
NODE_ENV=development

# Port on which the Node.js server will listen for requests
PORT=3002

# 2. DATABASE (PostgreSQL / Sequelize)

# DB host

DB_HOST=localhost
DB_PORT=5434
DB_USER=db_admin
DB_PASSWORD=snow
DB_NAME=test_db


# 3. SECURITY AND AUTHENTICATION (JWT)

# Secret key for signing tokens
JWT_SECRET=jwt-key
JWT_EXPIRES_IN=1h